@model EnrollmentDetailsViewModel
@{
    ViewData["Title"] = "Enrollment Details";
}

<div class="container-fluid px-4">

    <h4 class="my-4">Teacher Information</h4>

    <!-- Teacher Information -->
    <div class="card shadow-sm border-1 mb-4">
        <div class="card-body p-4">

            <div class="row align-items-center">

                <!-- Teacher Profile -->
                <div class="col-md-6">
                    @if (Model.EnrolledTeacher != null)
                    {
                        <div class="d-flex align-items-center">

                            <img src="~/image/default-user-profile.png"
                                 alt="Teacher Profile"
                                 class="rounded-circle border border-3 border-primary me-4 flex-shrink-0"
                                 width="140"
                                 height="140"
                                 style="object-fit: cover;" />

                            <div>
                                <input type="hidden"
                                       id="teacherGuid"
                                       value="@Model.EnrolledTeacher.TeacherGuid" />

                                <h2 class="fw-bold text-dark mb-3">
                                    @Model.EnrolledTeacher.FullName
                                </h2>

                                <p class="text-muted mb-2">
                                    <i class="fa-solid fa-building text-primary me-2"></i>
                                    <strong class="text-dark">Department:</strong>
                                    @Model.EnrolledTeacher.Department
                                </p>

                                <p class="text-muted mb-2">
                                    <i class="fa-solid fa-venus-mars text-primary me-2"></i>
                                    <strong class="text-dark">Gender:</strong>
                                    @Model.EnrolledTeacher.Gender
                                </p>

                                <p class="text-muted mb-0">
                                    <i class="fa-solid fa-user-tie text-primary me-2"></i>
                                    <strong class="text-dark">Role:</strong>
                                    Teacher
                                </p>
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center">
                            <p class="text-muted mb-3">
                                <i class="fa-solid fa-user-slash text-danger me-2"></i>
                                No teacher is currently assigned to this class.
                            </p>
                            <a class="btn btn-sm btn-primary" asp-controller="Teachers" asp-action="Index">Assign Teacher</a>
                        </div>
                    }
                </div>

                <!-- Class Information -->
                <div class="col-md-6 border-start">
                    <div class="ps-md-4">

                        <input type="hidden"
                               id="classGuid"
                               value="@Model.EnrolledClass.ClassGuid" />

                        <h5 class="fw-bold text-dark mb-3">
                            Class Information
                        </h5>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-chalkboard text-primary me-2"></i>
                            <strong class="text-dark">Class Name:</strong>
                            @Model.EnrolledClass.ClassName
                        </p>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-book text-primary me-2"></i>
                            <strong class="text-dark">Subject:</strong>
                            @Model.EnrolledClass.SubjectName
                        </p>

                        <p class="text-muted mb-0">
                            <i class="fa-solid fa-layer-group text-primary me-2"></i>
                            <strong class="text-dark">Section:</strong>
                            @Model.EnrolledClass.Section
                        </p>

                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Enrolled Student List -->
    <div class="card my-4">
        <div class="card-header fs-5 fw-semibold">
            <i class="fas fa-table me-1"></i>
            Students List
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <table id="students_table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Student Code</th>
                                <th>Full Name</th>
                                <th>Gender</th>
                                <th>IsActive</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.js" asp-append-version="true"></script>

    <script src="~/lib/datatables-buttons/dataTables.buttons.min.js" asp-append-version="true"></script>
    <script src="~/js/admin-enrolled-class-students.js" asp-append-version="true"></script>
}
