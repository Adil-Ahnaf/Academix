@model MarkSubmissionsViewModel

@{
    ViewData["Title"] = "Mark Submissions";
}

<div class="container-fluid px-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h4 class="mb-1 fw-semibold">Mark Submissions</h4>
            <p class="text-muted mb-0">
                Review student submissions, assign marks and provide feedback.
            </p>
        </div>
    </div>


    <!-- Assignment Information -->
    <div class="card shadow-sm border-1 mb-4">

        <div class="card-body p-4">

            <input type="hidden" id="assignmentGuid" value="@Model.AssignmentInfo?.AssignmentGuid" />

            <div class="row g-4">

                <!-- Assignment Details -->
                <div class="col-md-6">

                    <div class="d-flex align-items-start mb-3">
                        <div class="text-primary me-3">
                            <i class="fa-solid fa-file-alt fa-lg"></i>
                        </div>

                        <div>
                            <small class="text-muted d-block">Assignment</small>
                            <strong>
                                @Model.AssignmentInfo?.Title
                            </strong>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3">
                        <div class="text-primary me-3">
                            <i class="fa-solid fa-calendar-alt fa-lg"></i>
                        </div>

                        <div>
                            <small class="text-muted d-block">Deadline</small>
                            <strong>
                                @Model.AssignmentInfo?.Deadline
                            </strong>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="text-primary me-3">
                            <i class="fa-solid fa-star fa-lg"></i>
                        </div>

                        <div>
                            <small class="text-muted d-block">Total Marks</small>
                            <strong>
                                @Model.AssignmentInfo?.Marks
                            </strong>
                        </div>
                    </div>

                </div>


                <!-- Class Details -->
                <div class="col-md-6 border-start">

                    <div class="ps-md-4">

                        <div class="d-flex align-items-start mb-3">
                            <div class="text-primary me-3">
                                <i class="fa-solid fa-chalkboard fa-lg"></i>
                            </div>

                            <div>
                                <small class="text-muted d-block">Class</small>
                                <strong>
                                    @Model.ClassInfo?.ClassName
                                </strong>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <div class="text-primary me-3">
                                <i class="fa-solid fa-book fa-lg"></i>
                            </div>

                            <div>
                                <small class="text-muted d-block">Subject</small>
                                <strong>
                                    @Model.ClassInfo?.SubjectName
                                </strong>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <div class="text-primary me-3">
                                <i class="fa-solid fa-layer-group fa-lg"></i>
                            </div>

                            <div>
                                <small class="text-muted d-block">Section</small>
                                <strong>
                                    @Model.ClassInfo?.Section
                                </strong>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- Students List -->
    <div class="card shadow-sm border-1 my-5 py-3">

        <!-- Table Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <!-- Title -->
                <div>
                    <h5 class="mb-1 fw-semibold">
                        <i class="fa-solid fa-users text-primary me-2"></i>
                        Students List
                    </h5>

                    <small class="text-muted">
                        Review submissions and assign marks.
                    </small>
                </div>


                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2">

                    <!-- Edit / Save All -->
                    <button type="button" id="btnEditAll" class="btn btn-sm btn-outline-primary">

                        <i class="fa-solid fa-pen me-1"></i>
                        <span>Edit All</span>

                    </button>


                    <!-- Download All -->
                    <button type="button" id="btnDownloadAll" class="btn btn-sm btn-outline-secondary">

                        <i class="fa-solid fa-download me-1"></i>
                        Download All Files

                    </button>


                    <!-- Export -->
                    <button type="button" id="btnExportList" class="btn btn-sm btn-outline-success">

                        <i class="fa-solid fa-file-export me-1"></i>
                        Export List

                    </button>

                </div>

            </div>

        </div>

        <form id="export-to-file-form" method="POST" enctype="application/x-www-form-urlencoded">
            <input type="hidden" name="assignmentGuid" id="exportAssignmentGuid" value="@Model.AssignmentInfo?.AssignmentGuid" />

            <input type="hidden" name="dtParametersJson" id="dtParametersJson" />
        </form>

        <!-- Table -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="students_table" class="table table-hover table-bordered align-middle w-100">

                    <thead class="table-light">

                        <tr>
                            <th>Student ID</th>
                            <th>Full Name</th>
                            <th>Submitted File</th>
                            <th style="width:120px;">Marks</th>
                            <th style="min-width:250px;">Feedback</th>
                            <th style="width:100px;">Action</th>
                        </tr>

                    </thead>

                </table>

            </div>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.css" asp-append-version="true" />
}

@section Scripts {

    <script src="~/lib/datatables/js/jquery.dataTables.js" asp-append-version="true"></script>

    <script src="~/lib/datatables/js/dataTables.bootstrap5.js" asp-append-version="true"></script>

    <script src="~/lib/datatables-buttons/dataTables.buttons.min.js" asp-append-version="true"></script>

    <script src="~/js/assignment-mark-submissions.js" asp-append-version="true"></script>
}
