@model Portal.Models.TeacherEnrollmentsViewModel
@{
    ViewData["Title"] = "Teacher Enrollments";
}
<div class="container-fluid px-4">
    <h4 class="my-4">Dashboard</h4>

    <div class="row">
        <div class="col-12">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start">

                        <!-- Left: Profile Photo -->
                        <div class="me-md-4 mb-3 mb-md-0 text-center">
                            <img src="~/image/default-user-profile.png"
                                 alt="Teacher Profile"
                                 class="rounded-circle border border-white border-3"
                                 width="140"
                                 height="140"
                                 style="object-fit:cover;">
                        </div>

                        <!-- Right: Teacher Information -->
                        <div class="flex-grow-1 text-center text-md-start">
                            <h2 class="fw-bold mb-2">@Model.Teacher.FullName</h2>

                            <p class="mb-1">
                                <i class="fa-solid fa-building me-2"></i>
                                <strong>Department:</strong> @Model.Teacher.Department
                            </p>

                            <p class="mb-1">
                                <i class="fa-solid fa-venus-mars me-2"></i>
                                <strong>Gender:</strong> @Model.Teacher.Gender
                            </p>

                            <p class="mb-0">
                                <i class="fa-solid fa-user-tie me-2"></i>
                                <strong>Role:</strong> Teacher
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>