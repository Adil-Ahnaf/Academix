@model TeacherDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4">

    <!-- ============================= -->
    <!-- Dashboard Header -->
    <!-- ============================= -->
    <div class="d-flex justify-content-between align-items-center my-4">

        <div>
            <h4 class="fw-bold text-dark mb-1">
                Dashboard
            </h4>

            <small class="text-muted">
                Welcome back, @Model.Teacher.FullName
            </small>
        </div>

    </div>


    <!-- ============================= -->
    <!-- Teacher Profile -->
    <!-- ============================= -->
    <div class="card shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <!-- Teacher Information -->
                <div class="col-lg-6">

                    <div class="d-flex align-items-center">

                        <img src="~/image/default-user-profile.png"
                             alt="Teacher Profile"
                             class="rounded-circle border border-3 border-primary me-4 flex-shrink-0"
                             width="120"
                             height="120"
                             style="object-fit: cover;" />

                        <div>

                            <h3 class="fw-bold text-dark mb-3">
                                @Model.Teacher.FullName
                            </h3>

                            <p class="text-muted mb-2">
                                <i class="fa-solid fa-building text-primary me-2"></i>
                                <strong class="text-dark">Department:</strong>
                                @Model.Teacher.Department
                            </p>

                            <p class="text-muted mb-2">
                                <i class="fa-solid fa-venus-mars text-primary me-2"></i>
                                <strong class="text-dark">Gender:</strong>
                                @Model.Teacher.Gender
                            </p>

                            <p class="text-muted mb-0">
                                <i class="fa-solid fa-user-tie text-primary me-2"></i>
                                <strong class="text-dark">Role:</strong>
                                Teacher
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Teaching Summary -->
                <div class="col-lg-6 mt-4 mt-lg-0">

                    <div class="border-start ps-lg-4">

                        <div class="row align-items-center">

                            <!-- Image -->
                            <div class="col-auto">

                                <img src="~/image/books.png"
                                     alt="Classes"
                                     class="rounded-4 border"
                                     width="110"
                                     height="110"
                                     style="object-fit: cover;" />

                            </div>


                            <!-- Summary -->
                            <div class="col">

                                <p class="text-muted fw-semibold mb-1">
                                    Total Enrolled Classes
                                </p>

                                <p class="fw-bold text-primary mb-0 fs-1">
                                    @Model.AllClasses.Count()
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- My Classes Header -->
    <!-- ============================= -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h5 class="fw-bold text-dark mb-1">
                My Classes
            </h5>

            <small class="text-muted">
                Classes currently assigned to you
            </small>

        </div>

        <div>

            <span class="badge bg-primary rounded-pill px-3 py-2">
                @Model.AllClasses.Count() Classes
            </span>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Classes -->
    <!-- ============================= -->
    <div class="row g-3">

        @foreach (var item in Model.AllClasses)
        {
            <!-- ================= CARD ================= -->
            <div class="col-12 col-lg-6">

                <div class="card border shadow-sm h-100">

                    <div class="card-body p-4">

                        <!-- Class Header -->
                        <div class="d-flex justify-content-between align-items-center">

                            <div class="d-flex align-items-center">

                                <!-- Icon -->
                                <div class="rounded-3 bg-primary bg-opacity-10 text-primary
                                    d-flex align-items-center justify-content-center me-3"
                                     style="width:50px;height:50px;">

                                    <i class="fa-solid fa-book fa-lg"></i>

                                </div>

                                <!-- Class Name -->
                                <div>

                                    <p class="fw-bold text-dark mb-1">
                                        @item.ClassName
                                    </p>

                                    <small class="text-muted">
                                        @item.SubjectName
                                        <span class="mx-1">•</span>
                                        Section @item.Section
                                    </small>

                                </div>

                            </div>


                            <!-- Students -->
                            <div class="text-center">

                                <div class="fw-bold text-success fs-5">
                                    @item.TotalEnrolled
                                </div>

                                <small class="text-muted">
                                    <i class="fa-solid fa-users text-success me-1"></i>
                                    Students
                                </small>

                            </div>

                        </div>


                        <hr class="my-3">


                        <!-- Footer -->
                        <div class="d-flex justify-content-between align-items-center">

                            <span class="text-muted">

                                <i class="fa-solid fa-file-lines text-warning me-1"></i>

                                @if (item.TotalAssignment == null)
                                {
                                    <strong class="text-dark">0</strong>
                                }
                                else
                                {
                                    <strong class="text-dark">@item.TotalAssignment</strong>

                                }
                                Assignments
                            </span>

                            <a class="btn btn-sm btn-outline-primary" asp-controller="Classes"
                               asp-action="EnrollmentDetails" asp-route-classGuid="@item.ClassGuid">

                                Manage Class
                                <i class="fa-solid fa-arrow-right ms-1"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>