@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4">
    <h4 class="my-4">Dashboard</h4>
    <!-- Teacher Information -->
    <div class="card shadow-sm border-1 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">

                <img src="~/image/default-user-profile.png"
                     alt="Teacher Profile"
                     class="rounded-circle border border-3 border-primary me-4"
                     width="140"
                     height="140"
                     style="object-fit:cover;" />

                <div>
                    <input type="hidden" id="teacherGuid" value="@Model.Teacher.TeacherGuid" />
                    <h2 class="fw-bold text-dark mb-3">@Model.Teacher.FullName</h2>
                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-building text-primary me-2"></i>
                        <strong class="text-dark">Department:</strong> @Model.Teacher.Department
                    </p>

                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-venus-mars text-primary me-2"></i>
                        <strong class="text-dark">Gender:</strong> @Model.Teacher.Gender
                    </p>

                    <p class="text-muted mb-0">
                        <i class="fa-solid fa-user-tie text-primary me-2"></i>
                        <strong class="text-dark">Role:</strong> Teacher
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>
