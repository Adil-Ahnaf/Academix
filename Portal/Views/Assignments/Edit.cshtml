@model AssignmentsViewModelEdit

@{
    ViewData["Title"] = "Edit Assignment";
}

@section Styles {
    <link href="~/lib/quill-editor/quill.css" rel="stylesheet" asp-append-version="true">
}

<div class="container-fluid px-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 my-4">

        <div>
            <h4 class="mb-1 fw-semibold">Edit Assignment</h4>

            <p class="text-muted mb-0">
                Update the information and settings for this assignment.
            </p>
        </div>

        <div>
            <a asp-controller="Assignments"
               asp-action="Index"
               class="btn btn-light border">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Assignments
            </a>
        </div>

    </div>


    <!-- Class Information -->
    <div class="card border-1 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-sm-row
                justify-content-between align-items-sm-center gap-3">

                <div class="d-flex align-items-center">

                    <div class="rounded-3 bg-primary bg-opacity-10
                        text-primary d-flex align-items-center
                        justify-content-center me-3"
                         style="width:50px;height:50px;">

                        <i class="fa-solid fa-book fa-lg"></i>

                    </div>

                    <div>

                        <div class="d-flex flex-wrap
                            align-items-center gap-2">

                            <h5 class="fw-semibold text-dark mb-0">
                                @Model.ClassInfo.ClassName
                            </h5>

                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                Section @Model.ClassInfo.Section
                            </span>

                        </div>

                        <div class="text-muted small mt-1">
                            Subject: @Model.ClassInfo.SubjectName
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- Main Form Card -->
    <div class="card border-1 shadow-sm mb-4">

        <div class="card-body p-4 p-lg-5">

            <form method="post" asp-controller="Assignments" asp-action="Update" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                </div>

                <!-- Hidden values -->
                <div class="d-none">

                    <input asp-for="AssignmentGuid" value="@Model.AssignmentGuid" />

                    <input asp-for="ClassGuid" value="@Model.ClassInfo.ClassGuid" />

                    <input asp-for="ClassId" value="@Model.ClassInfo.Id" />

                    <input asp-for="ClassName" value="@Model.ClassInfo.ClassName" />

                    <input asp-for="Section" value="@Model.ClassInfo.Section" />

                </div>


                <!-- Assignment Title -->
                <div class="mb-4">

                    <label asp-for="Title" class="form-label fw-medium">
                        Assignment Title
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Title" class="form-control" maxlength="200" />

                    <span asp-validation-for="Title" class="text-danger small"></span>

                </div>


                <!-- Assignment File -->
                <div class="mb-4">
                    <label asp-for="FilePath" class="form-label fw-medium">
                        Assignment File
                        <span class="text-danger">*</span>
                    </label>

                    <!-- Existing File -->
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingFilePath))
                    {
                        <div class="border rounded-3 p-3 mb-3 bg-light">

                            <div class="d-flex align-items-center gap-3">

                                <div class="flex-shrink-0">

                                    <div class="bg-white border rounded-3 d-flex align-items-center justify-content-center"
                                         style="width:48px;height:48px;">

                                        <i class="fa-solid fa-file-lines
                                            text-primary fs-5">
                                        </i>

                                    </div>

                                </div>


                                <div class="flex-grow-1">

                                    <div class="fw-medium">
                                        Current Attachment
                                    </div>

                                    <div class="text-muted small">
                                        @System.IO.Path.GetFileName(Model.ExistingFilePath)
                                    </div>

                                </div>


                                <div class="flex-shrink-0">

                                    <a asp-controller="Assignments" asp-action="Download" asp-route-assignmentGuid="@Model.AssignmentGuid"
                                       target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                                        Open
                                    </a>

                                </div>

                            </div>

                        </div>
                    }


                    <!-- New File -->
                    <div class="border rounded-3 p-3 bg-light">

                        <div class="d-flex align-items-center gap-3">

                            <div class="flex-shrink-0">

                                <div class="bg-white border rounded-3 d-flex align-items-center justify-content-center"
                                     style="width:48px;height:48px;">

                                    <i class="fa-solid fa-file-arrow-up
                                        text-primary fs-5">
                                    </i>

                                </div>

                            </div>


                            <div class="flex-grow-1">

                                <input asp-for="FilePath" type="file" class="form-control"
                                       accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt" />

                                <div class="form-text">

                                    Select a new file only if you want to replace the current attachment.

                                    Supported files: PDF, Word, PowerPoint, Excel and TXT.

                                </div>

                            </div>

                        </div>

                    </div>


                    <span asp-validation-for="FilePath" class="text-danger small"></span>

                </div>


                <!-- Description -->
                <div class="mb-4">

                    <label asp-for="Description" class="form-label fw-medium">

                        Description

                        <span class="text-muted fw-normal">
                            (Optional)
                        </span>

                    </label>

                    <textarea asp-for="Description" class="form-control" rows="7"></textarea>

                    <div class="form-text">
                        Provide clear instructions for students.
                    </div>

                </div>


                <!-- Marks & Deadline -->
                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="Marks" class="form-label fw-medium">

                            Maximum Marks
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group">

                            <input asp-for="Marks" type="number" class="form-control" min="1" max="100" placeholder="100" />

                            <span class="input-group-text">Marks</span>

                        </div>

                        <span asp-validation-for="Marks" class="text-danger small"></span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Deadline" class="form-label fw-medium">

                            Submission Deadline
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="Deadline" type="datetime-local" class="form-control" />

                        <span asp-validation-for="Deadline" class="text-danger small">
                        </span>

                        <div class="form-text">
                            Students cannot submit after this deadline.
                        </div>

                    </div>

                </div>


                <hr class="my-5" />


                <!-- Assignment Status -->
                <div class="mb-4">

                    <h5 class="fw-semibold mb-1">
                        Assignment Status
                    </h5>

                    <p class="text-muted small mb-0">
                        Choose whether the assignment should be published or saved as a draft.
                    </p>

                </div>


                <div class="row g-3">

                    <!-- Draft -->
                    <div class="col-md-6">

                        <div class="form-check border rounded-3 p-3 h-100">

                            <input class="form-check-input ms-0 me-2" type="radio" asp-for="IsPublish" value="false" id="saveDraft" />

                            <label class="form-check-label" for="saveDraft">

                                <span class="fw-semibold">

                                    <i class="fa-solid fa-file-pen text-warning me-2"></i>

                                    Save as Draft

                                </span>

                                <span class="d-block text-muted small mt-1">

                                    Save the assignment without publishing it to students.

                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- Publish -->
                    <div class="col-md-6">

                        <div class="form-check border rounded-3 p-3 h-100">

                            <input class="form-check-input ms-0 me-2" type="radio" asp-for="IsPublish" value="true"
                                   id="publishAssignment" />

                            <label class="form-check-label" for="publishAssignment">

                                <span class="fw-semibold">

                                    <i class="fa-solid fa-paper-plane text-success me-2"></i>

                                    Publish Assignment

                                </span>

                                <span class="d-block text-muted small mt-1">

                                    Make the assignment available to students.

                                </span>

                            </label>

                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-5 pt-4 border-top">

                    <a asp-controller="Assignments" asp-action="AllAssignments" asp-route-classGuid="@Model.ClassInfo.ClassGuid"
                       class="btn btn-light border px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Cancel

                    </a>


                    <button type="submit" class="btn btn-primary px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Update

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
